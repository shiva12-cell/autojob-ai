# Google Cloud / Workspace Integration
GOOGLE_APPLICATION_CREDENTIALS_FILE=config/credentials/credentials.json
GOOGLE_TOKEN_FILE=config/credentials/token.json
GOOGLE_SERVICE_ACCOUNT_FILE=config/credentials/service_account.json
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Job_Applications

# Applier Settings
USER_PROFILE_PATH=config/profile.yaml
RESUME_PATH=resumes/resume.pdf

# Automation Settings
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
MAX_APPLICATIONS_PER_RUN=10
AUTO_TRACKER_INTERVAL_MINUTES=30

# Security & Server Hardening
ADMIN_API_KEY=your_secure_admin_api_key_here
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ENABLE_API_DOCS=false
COOKIE_SECURE=false
SESSION_LIFETIME_DAYS=7
RATE_LIMIT_ENABLED=true

# Database (Cloud Neon PostgreSQL or Local SQLite fallback)
# Optional: Set this to your Neon PostgreSQL connection string on cloud deployments.
# If unset, AutoJob AI automatically uses local SQLite (data/autojob.db).
# DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
